    "@types/bcrypt": "^6.0.0",
    "@types/node": "^22.15.29",
    "eslint": "^9.28.0",
    "prisma": "^6.9.0",
    "tsx": "^4.23.15",
    "typescript": "^5.8.3"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
